# Meal Rescue - Mobile Environment
# Copy to .env and fill in real values. NEVER commit .env.
# All EXPO_PUBLIC_ vars are inlined into the client bundle - never put secrets here.

# Backend API
# iOS simulator: http://localhost:3000 | Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Firebase (optional until the Firebase project is provisioned)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# RevenueCat (Phase 5+)
EXPO_PUBLIC_REVENUECAT_PUBLIC_KEY=

# OneSignal (Phase 5+)
EXPO_PUBLIC_ONE_SIGNAL_APP_ID=
