# Meal Rescue - Mobile Environment
# Copy to .env and fill in real values. NEVER commit .env.
# All EXPO_PUBLIC_ vars are inlined into the client bundle - never put secrets here.

# Backend API
# iOS simulator: http://localhost:3010 | Android emulator: http://10.0.2.2:3010
# Do not use localhost from the Android emulator; it points to the emulator itself.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3010

# RevenueCat (free tier, no card). https://www.revenuecat.com
# Leave empty to keep purchases disabled in dev. Real IAP needs both keys.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Google AdMob App IDs (free). https://apps.admob.com -> App settings -> App ID
# REQUIRED before `expo run:android` / `expo run:ios`: the native Google Mobile
# Ads SDK crashes on launch without a valid App ID.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# Google AdMob rewarded ad-unit IDs (free). https://apps.admob.com -> Ad units
# Leave empty to use AdMob's built-in TestIds in dev builds.
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_ID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS_ID=

# Google AdMob interstitial ad-unit IDs (free). https://apps.admob.com -> Ad units
# Leave empty to use AdMob's built-in TestIds in dev builds.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS_ID=

# OneSignal (free). https://dashboard.onesignal.com -> Settings -> Keys & IDs
# Empty = reminders disabled.
EXPO_PUBLIC_ONESIGNAL_APP_ID=