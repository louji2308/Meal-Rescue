# Meal Rescue API - Backend Environment
# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://meal_rescue:local_password@localhost:5432/meal_rescue_dev
DB_POOL_MAX=20
DB_POOL_MIN=2

# Redis
REDIS_URL=redis://localhost:6379
# Set to true to run without Redis locally (graceful degradation)
REDIS_DISABLED=false

# Auth - REQUIRED in production, must be a strong random value
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=24h

# Firebase Admin SDK (optional until Firebase project is provisioned)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI Services (Phase 2)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_VERSION=

# Storage (Phase 2+)
GCS_BUCKET_NAME=

# CORS - comma-separated origins, or * for development
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN=
