# Meal Rescue API - Backend Environment
# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://meal_rescue:local_password@localhost:5432/meal_rescue_dev
DB_POOL_MAX=20
DB_POOL_MIN=2

# Redis
REDIS_URL=redis://localhost:6379
# Set to true to run without Redis locally (graceful degradation)
REDIS_DISABLED=false

# Auth - REQUIRED in production, must be a strong random value
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=24h

# Firebase Admin SDK (optional until Firebase project is provisioned)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# RevenueCat server-to-server webhook (optional in dev, required in prod)
REVENUECAT_WEBHOOK_SECRET=

# OneSignal push notifications (optional - dry-run when unset)
ONESIGNAL_REST_KEY=
ONESIGNAL_APP_ID=

# AI services
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1500
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# Storage (Phase 2+)
GCS_BUCKET_NAME=

# CORS - comma-separated origins, or * for development
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Ad rewards (defaults: 2 credits per ad, 60 min Pro Pass)
AD_REWARD_CREDITS=2
PRO_PASS_MINUTES=60

# Monitoring
SENTRY_DSN=
